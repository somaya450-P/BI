<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="page_about" model="website.page">
        <field name="name">About Me</field>
        <field name="type">qweb</field>
        <field name="key">somaya_portfolio.page_about</field>
        <field name="url">/about</field>
        <field name="is_published">True</field>
        <field name="website_indexed">True</field>
        <field name="arch" type="xml">
            <t t-call="website.layout">
                <t t-set="lang_code" t-value="request.env.context.get('lang', 'en_US')"/>
                <div id="wrap" class="o_somaya_about">

                    <section class="o_somaya_page_header">
                        <div class="container">
                            <h1>
                                <t t-if="lang_code == 'ar_001'">نبذة عني</t>
                                <t t-else="">About Me</t>
                            </h1>
                            <p class="o_somaya_page_header_sub">
                                <t t-if="lang_code == 'ar_001'">سمية العاصمي — محللة بيانات وذكاء أعمال</t>
                                <t t-else="">Somaya Alasmi — Data Analyst &amp; Business Intelligence</t>
                            </p>
                        </div>
                    </section>

                    <section class="o_somaya_about_bio">
                        <div class="container">
                            <div class="row">
                                <div class="col-lg-8">
                                    <t t-if="lang_code == 'ar_001'">
                                        <p>أعمل على تحويل البيانات الخام والمبعثرة إلى رؤى واضحة ولوحات تحكم تفاعلية تدعم اتخاذ قرارات أفضل.</p>
                                        <p>أتعامل مع دورة تحليل البيانات بشكل متكامل، بدءًا من تنظيف البيانات وتحويلها باستخدام Excel وPower Query، مرورًا ببناء نماذج البيانات والعلاقات وكتابة مقاييس DAX، وصولًا إلى تصميم لوحات Power BI التفاعلية ومؤشرات الأداء.</p>
                                        <p>تساعدني خلفيتي الأكاديمية في إدارة الأعمال على قراءة البيانات ضمن سياقها التجاري، وربط المؤشرات بالأهداف والأداء والمخاطر والاتجاهات، بدلًا من التعامل مع الأرقام كقيم منفصلة.</p>
                                        <p>طبّقت هذه المهارات على مجموعة متنوعة من المشاريع التحليلية، شملت التحليل المالي والميزانيات، أداء المبيعات، العقارات، الائتمان وسلوك إنفاق المستهلك، المخاطر التشغيلية، وتحليل التبرعات.</p>
                                        <p>هدفي هو تبسيط البيانات المعقدة وتقديمها بصورة واضحة تساعد على اكتشاف الأنماط، وقياس الأداء، واستخلاص الرؤى المهمة، ودعم القرارات المبنية على البيانات.</p>
                                    </t>
                                    <t t-else="">
                                        <p>I transform raw and fragmented data into clear insights and interactive dashboards that support better decision-making.</p>
                                        <p>I work across the full data analysis process — from cleaning and transforming data using Excel and Power Query, to building data models and relationships, developing DAX measures, and designing interactive Power BI dashboards and performance indicators.</p>
                                        <p>My academic background in Business Administration helps me interpret data within its business context, connecting metrics to objectives, performance, risks, and trends rather than viewing numbers as isolated values.</p>
                                        <p>I have applied these skills across a diverse range of analytical projects, including financial and budget analysis, sales performance, real estate, consumer credit and spending behavior, operational risk, and donation analysis.</p>
                                        <p>My goal is to simplify complex data and communicate it clearly, making it easier to identify patterns, measure performance, uncover meaningful insights, and support data-driven decision-making.</p>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </section>

                    <section class="o_somaya_about_how">
                        <div class="container">
                            <h2 class="o_somaya_section_title">
                                <t t-if="lang_code == 'ar_001'">طريقة عملي</t>
                                <t t-else="">How I Work</t>
                            </h2>
                            <div class="o_somaya_flow">
                                <t t-if="lang_code == 'ar_001'">
                                    <span>تجهيز البيانات</span><span class="o_somaya_flow_arrow">←</span>
                                    <span>التحويل</span><span class="o_somaya_flow_arrow">←</span>
                                    <span>النمذجة</span><span class="o_somaya_flow_arrow">←</span>
                                    <span>DAX</span><span class="o_somaya_flow_arrow">←</span>
                                    <span>التصور المرئي</span><span class="o_somaya_flow_arrow">←</span>
                                    <span>الرؤى</span>
                                </t>
                                <t t-else="">
                                    <span>Data preparation</span><span class="o_somaya_flow_arrow">→</span>
                                    <span>Transformation</span><span class="o_somaya_flow_arrow">→</span>
                                    <span>Modeling</span><span class="o_somaya_flow_arrow">→</span>
                                    <span>DAX</span><span class="o_somaya_flow_arrow">→</span>
                                    <span>Visualization</span><span class="o_somaya_flow_arrow">→</span>
                                    <span>Insights</span>
                                </t>
                            </div>
                        </div>
                    </section>

                    <section class="o_somaya_about_business">
                        <div class="container">
                            <div class="row align-items-center">
                                <div class="col-lg-6">
                                    <h2 class="o_somaya_section_title">
                                        <t t-if="lang_code == 'ar_001'">المنظور التجاري</t>
                                        <t t-else="">Business Perspective</t>
                                    </h2>
                                    <p>
                                        <t t-if="lang_code == 'ar_001'">
                                            تساعدني خلفيتي الأكاديمية في إدارة الأعمال على قراءة البيانات ضمن سياقها التجاري، وربط المؤشرات بالأهداف والأداء والمخاطر والاتجاهات.
                                        </t>
                                        <t t-else="">
                                            My academic background in Business Administration helps me interpret data within its business context — connecting metrics to objectives, performance, risks, and trends.
                                        </t>
                                    </p>
                                </div>
                            </div>
                        </div>
                    </section>

                    <section class="o_somaya_about_experience">
                        <div class="container">
                            <h2 class="o_somaya_section_title">
                                <t t-if="lang_code == 'ar_001'">الخبرة التحليلية</t>
                                <t t-else="">Analytical Experience</t>
                            </h2>
                            <div class="row o_somaya_tag_grid">
                                <t t-foreach="[
                                        ('Financial &amp; Budget Analysis', 'التحليل المالي والميزانيات'),
                                        ('Sales Performance', 'أداء المبيعات'),
                                        ('Real Estate Analysis', 'تحليل العقارات'),
                                        ('Consumer Behavior &amp; Credit Analysis', 'تحليل سلوك المستهلك والائتمان'),
                                        ('Operational Risk Analysis', 'تحليل المخاطر التشغيلية'),
                                        ('Donation Analysis', 'تحليل التبرعات'),
                                    ]" t-as="item">
                                    <div class="col-6 col-md-4 mb-3">
                                        <div class="o_somaya_tag_card">
                                            <t t-if="lang_code == 'ar_001'" t-out="item[1]"/>
                                            <t t-else="" t-out="item[0]"/>
                                        </div>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </section>

                    <section class="o_somaya_skills">
                        <div class="container">
                            <h2 class="o_somaya_section_title">
                                <t t-if="lang_code == 'ar_001'">المهارات</t>
                                <t t-else="">Skills</t>
                            </h2>
                            <div class="row">

                                <div class="col-md-6 col-lg-3 mb-4">
                                    <div class="o_somaya_skill_card">
                                        <h3>
                                            <t t-if="lang_code == 'ar_001'">Power BI وذكاء الأعمال</t>
                                            <t t-else="">Power BI &amp; Business Intelligence</t>
                                        </h3>
                                        <ul>
                                            <li>Power BI</li>
                                            <li><t t-if="lang_code == 'ar_001'">نمذجة البيانات والعلاقات</t><t t-else="">Data Modeling &amp; Relationships</t></li>
                                            <li><t t-if="lang_code == 'ar_001'">مقاييس DAX</t><t t-else="">DAX Measures</t></li>
                                            <li>Power Query</li>
                                            <li><t t-if="lang_code == 'ar_001'">جداول التقويم وتحليل الزمن</t><t t-else="">Calendar Tables &amp; Time Intelligence</t></li>
                                            <li><t t-if="lang_code == 'ar_001'">التنسيق الشرطي</t><t t-else="">Conditional Formatting</t></li>
                                            <li><t t-if="lang_code == 'ar_001'">شجرة التحليل التفصيلي</t><t t-else="">Decomposition Tree</t></li>
                                            <li><t t-if="lang_code == 'ar_001'">لوحات تحكم تفاعلية</t><t t-else="">Interactive Dashboards</t></li>
                                            <li><t t-if="lang_code == 'ar_001'">تصور البيانات</t><t t-else="">Data Visualization</t></li>
                                        </ul>
                                    </div>
                                </div>

                                <div class="col-md-6 col-lg-3 mb-4">
                                    <div class="o_somaya_skill_card">
                                        <h3>
                                            <t t-if="lang_code == 'ar_001'">Excel وتجهيز البيانات</t>
                                            <t t-else="">Excel &amp; Data Preparation</t>
                                        </h3>
                                        <ul>
                                            <li><t t-if="lang_code == 'ar_001'">تنظيف البيانات وتحويلها</t><t t-else="">Data Cleaning &amp; Transformation</t></li>
                                            <li><t t-if="lang_code == 'ar_001'">إعادة هيكلة البيانات</t><t t-else="">Data Restructuring</t></li>
                                            <li><t t-if="lang_code == 'ar_001'">دوال البحث والتجميع</t><t t-else="">Lookup &amp; Aggregation Functions</t></li>
                                            <li>PivotTables</li>
                                            <li>Power Query</li>
                                            <li><t t-if="lang_code == 'ar_001'">التحقق من صحة البيانات</t><t t-else="">Data Validation</t></li>
                                            <li><t t-if="lang_code == 'ar_001'">التنسيق الشرطي</t><t t-else="">Conditional Formatting</t></li>
                                        </ul>
                                    </div>
                                </div>

                                <div class="col-md-6 col-lg-3 mb-4">
                                    <div class="o_somaya_skill_card">
                                        <h3>
                                            <t t-if="lang_code == 'ar_001'">تحليل البيانات والأعمال</t>
                                            <t t-else="">Data &amp; Business Analysis</t>
                                        </h3>
                                        <ul>
                                            <li><t t-if="lang_code == 'ar_001'">تحليل مؤشرات الأداء (KPI)</t><t t-else="">KPI Analysis</t></li>
                                            <li><t t-if="lang_code == 'ar_001'">مقارنة الفعلي بالمستهدف</t><t t-else="">Actual vs. Target Analysis</t></li>
                                            <li><t t-if="lang_code == 'ar_001'">تحليل الاتجاهات</t><t t-else="">Trend Analysis</t></li>
                                            <li><t t-if="lang_code == 'ar_001'">تحليل النمو السنوي (YoY)</t><t t-else="">YoY Analysis</t></li>
                                            <li><t t-if="lang_code == 'ar_001'">تحليل النمو الشهري (MoM)</t><t t-else="">MoM Analysis</t></li>
                                            <li><t t-if="lang_code == 'ar_001'">التحليل المالي والميزانيات</t><t t-else="">Financial &amp; Budget Analysis</t></li>
                                            <li><t t-if="lang_code == 'ar_001'">تحليل سلوك المستهلك</t><t t-else="">Consumer Behavior Analysis</t></li>
                                            <li><t t-if="lang_code == 'ar_001'">تحليل الإنفاق الاستهلاكي</t><t t-else="">Consumer Spending Analysis</t></li>
                                            <li><t t-if="lang_code == 'ar_001'">متابعة الأداء</t><t t-else="">Performance Monitoring</t></li>
                                        </ul>
                                    </div>
                                </div>

                                <div class="col-md-6 col-lg-3 mb-4">
                                    <div class="o_somaya_skill_card">
                                        <h3>
                                            <t t-if="lang_code == 'ar_001'">تحليل المخاطر</t>
                                            <t t-else="">Risk Analysis</t>
                                        </h3>
                                        <ul>
                                            <li><t t-if="lang_code == 'ar_001'">تحليل المخاطر</t><t t-else="">Risk Analysis</t></li>
                                            <li><t t-if="lang_code == 'ar_001'">مصفوفة المخاطر (Risk Matrix)</t><t t-else="">Risk Matrix</t></li>
                                            <li><t t-if="lang_code == 'ar_001'">درجة الخطر</t><t t-else="">Risk Score</t></li>
                                            <li><t t-if="lang_code == 'ar_001'">مؤشرات المخاطر</t><t t-else="">Risk Indicators</t></li>
                                            <li><t t-if="lang_code == 'ar_001'">متابعة مؤشرات الأداء والمخاطر (KPI / KRI)</t><t t-else="">KPI / KRI Monitoring</t></li>
                                            <li>ALE</li>
                                            <li>ROSI</li>
                                        </ul>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </section>

                </div>
            </t>
        </field>
    </record>

</odoo>
